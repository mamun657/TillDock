# =====================================================================
# TillDock .gitignore
# =====================================================================
# Anything checked in here will never be committed.
# Companion to .env.example, NOT a replacement for secrets management.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Operating system / editor noise
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
*.swp
*.swo
*~
*.lnk

# Windows Explorer / Office lock & temp
*.tmp
*.bak
*.cache
*.old
*.orig
*.rej

# Recycle / lock / hidden metadata
$RECYCLE.BIN/
*.lnk
*.lnk.meta

# IDEs / editors
.vscode/
.idea/
*.iml
*.iws
*.ipr
nbproject/
.project
.classpath
.settings/
.factorypath

# Puku editor metadata
.puku/

# ---------------------------------------------------------------------
# 2. Secrets & credentials
# ---------------------------------------------------------------------
.env
.env.*
!.env.example

# Token / JWT files anywhere in the repo
token.txt
*_token.txt
*_jwt.txt
me_token.txt
ui_token.txt

# Obfuscated / encoded secrets
*.b64
*.bin

# Private keys & certs
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks



# Any other XML hierarchy dump (matches android.uiautomator pattern)
*hierarchy*.xml
*uiautomator*.xml
*window_dump*.xml


# ---------------------------------------------------------------------
# 6. Temporary debug / request-response dumps
# ---------------------------------------------------------------------
*_response.json
*_payload.json
*_payload.txt
*_request.json
*_resp.json
*_req.json
r-out.json
r-in.json
bad.json
bad-resp.json
config.json
login.json
signup.json
signup-body.json
signup_pre.json
test1.json
test1.cmd
payload.txt
psql_args.txt
precreate_email.txt
emails.txt
activities.txt
schema_dump.txt
flyway_history.txt
smoke.txt
windows.txt
window_logs.txt

# Tokenized debug blobs
fk.b64
fk.bin
rp.bin
wp.bin

# Generic debug evidence
*debug*.txt
*debug*.log
*debug*.json
*debug*.bin

# ---------------------------------------------------------------------
# 7. Android build / IDE output
# ---------------------------------------------------------------------
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/
captures/
.externalNativeBuild
.cxx

# Gradle
.gradle/
build/
*/build/
*/*/build/

# Android Studio / IntelliJ
local.properties
/local.properties
*.iml
.idea/
/.idea/

# Keystore files
*.jks
*.keystore

# Proguard mapping outputs (keep proguard-rules.pro, ignore mapping artefacts)
proguard/
*.hprof
*.lst

# Crash logs
hs_err_pid*

# Test results
test-output/
test-results/
test_*.xml
TEST-*.xml

# ---------------------------------------------------------------------
# 8. Backend (Spring Boot / Gradle) build output
# ---------------------------------------------------------------------
backend/build/
backend/target/
backend/out/
backend/bin/
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Spring Boot fat-jar extracted layout
backend/lib-extracted/
backend/BOOT-INF/
backend/META-INF/
backend/classes/
backend/generated/
backend/tmp/

# Embedded PostgreSQL data directory (used for local dev)
backend/.pgdata/
backend/data/
backend/dbdata/

# Local config overrides (keep .env.example tracked, ignore real .env)
backend/.env
backend/.env.local
backend/.env.*.local
backend/run_env.ps1

# PID / port / process control
*.pid
pid.txt
catid.txt
backend/catid.txt
backend/pid.txt

# Uploaded user content (runtime artifacts)
backend/uploads/
uploads/
!backend/uploads/.gitkeep

# Log directory (runtime)
backend/logs/

# Compiled bytecode
backend/lib-extracted/BOOT-INF/classes/
backend/lib-extracted/BOOT-INF/lib/

# ---------------------------------------------------------------------
# 9. Throwaway shell / script artifacts
# ---------------------------------------------------------------------
_t.ps1
_t.cmd
_t.bat
test-bad.ps1
test-wrong.ps1
tw.ps1
write-bad.ps1
backend/write-bad.ps1
backend/run-cp.ps1
backend/run-detach.ps1
backend/run-direct.ps1

# ---------------------------------------------------------------------
# 10. Build / CI caches
# ---------------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Maven (if ever used)
.mvn/
mvnw
mvnw.cmd
mvn/wrapper/maven-wrapper.jar
