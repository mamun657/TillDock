# =====================================================================
# TillDock .gitignore
# =====================================================================
# Anything checked in here will never be committed.
# Companion to .env.example, NOT a replacement for secrets management.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Operating system / editor noise
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
*.swp
*.swo
*~
*.lnk

# Windows Explorer / Office lock & temp
*.tmp
*.bak
*.cache
*.old
*.orig
*.rej

# Recycle / lock / hidden metadata
$RECYCLE.BIN/
*.lnk
*.lnk.meta

# IDEs / editors
.vscode/
.idea/
*.iml
*.iws
*.ipr
nbproject/
.project
.classpath
.settings/
.factorypath

# Puku editor metadata
.puku/

# ---------------------------------------------------------------------
# 2. Secrets & credentials
# ---------------------------------------------------------------------
.env
.env.*
!.env.example

# Token / JWT files anywhere in the repo
token.txt
*_token.txt
*_jwt.txt
me_token.txt
ui_token.txt

# Obfuscated / encoded secrets
*.b64
*.bin

# Private keys & certs
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks

