<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night-mode color overrides.
         These names match the day-mode colors.xml; the resource resolver
         picks this file in night mode so every layout that references
         @color/text_strong, @color/surface_default, etc. automatically
         gets the inverted dark-theme values. -->

    <!-- Surfaces: dark in night mode -->
    <color name="surface_default">#FF1E293B</color>     <!-- slate-800 -->
    <color name="surface_muted">#FF0F172A</color>      <!-- slate-900 -->
    <color name="surface_subtle">#FF111827</color>     <!-- gray-900 -->
    <color name="surface_inverse">#FFF8FAFC</color>    <!-- near-white -->
    <color name="bg_app">#FF0F172A</color>

    <!-- Text: light in night mode -->
    <color name="text_strong">#FFF8FAFC</color>        <!-- near-white -->
    <color name="text_default">#FFCBD5E1</color>       <!-- slate-300 -->
    <color name="text_muted">#FF94A3B8</color>         <!-- slate-400 -->
    <color name="text_disabled">#FF475569</color>      <!-- slate-600 -->
    <color name="text_inverse">#FF0F172A</color>       <!-- dark for light bg -->
    <color name="text_on_brand">#FFFFFFFF</color>
    <color name="text_on_brand_muted">#CCFFFFFF</color>

    <!-- Borders -->
    <color name="border_default">#FF334155</color>      <!-- slate-700 -->
    <color name="border_strong">#FF475569</color>       <!-- slate-600 -->
    <color name="border_subtle">#FF1E293B</color>       <!-- slate-800 -->

    <!-- Status backgrounds with reduced opacity on dark surface -->
    <color name="success_bg">#FF064E3B</color>
    <color name="warning_bg">#FF78350F</color>
    <color name="danger_bg">#FF7F1D1D</color>
    <color name="info_bg">#FF1E3A8A</color>
    <color name="neutral_bg">#FF334155</color>

    <!-- Pills: brighter on dark -->
    <color name="status_in_stock_bg">#1A22C55E</color>
    <color name="status_low_bg">#1AF59E0B</color>
    <color name="status_out_bg">#1AEF4444</color>
    <color name="status_archived_bg">#1A94A3B8</color>

    <!-- Card backgrounds -->
    <color name="card_bg">#FF1E293B</color>
    <color name="placeholder_bg">#FF1E293B</color>

    <!-- Legacy aliases -->
    <color name="text_primary">#FFF8FAFC</color>
    <color name="text_secondary">#FF94A3B8</color>
    <color name="divider">#FF334155</color>
</resources>
