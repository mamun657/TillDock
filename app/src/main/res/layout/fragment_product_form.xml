<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingTop="48dp"
            android:paddingBottom="@dimen/space_lg">

            <ImageButton
                android:id="@+id/product_form_back"
                android:layout_width="@dimen/icon_btn_size_md"
                android:layout_height="@dimen/icon_btn_size_md"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/common_back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/product_form_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:text="@string/products_add"
                android:textColor="@color/text_on_brand"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_lg">

                <ImageView
                    android:id="@+id/product_form_image"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/product_hero_height"
                    android:background="@drawable/bg_image_rounded"
                    android:contentDescription="@string/product_label_image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_image_placeholder" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/product_form_button_camera"
                        style="@style/TillDock.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/product_image_pick_camera" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/product_form_button_gallery"
                        style="@style/TillDock.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="@string/product_image_pick_gallery" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/product_form_button_remove_image"
                    style="@style/TillDock.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/product_image_remove"
                    android:textColor="@color/error_default"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/product_form_name_layout"
                style="@style/TillDock.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:hint="@string/products_label_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/product_form_input_name"
                    style="@style/TillDock.Input.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/product_form_sku_layout"
                style="@style/TillDock.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/products_label_sku">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/product_form_input_sku"
                    style="@style/TillDock.Input.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/products_label_category"
                android:textColor="@color/text_strong"
                android:textSize="14sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/product_form_category_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/product_form_description_layout"
                style="@style/TillDock.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/products_label_description">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/product_form_input_description"
                    style="@style/TillDock.Input.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/product_form_purchase_layout"
                    style="@style/TillDock.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/products_label_purchase_price">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/product_form_input_purchase_price"
                        style="@style/TillDock.Input.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/product_form_selling_layout"
                    style="@style/TillDock.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:hint="@string/products_label_selling_price">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/product_form_input_selling_price"
                        style="@style/TillDock.Input.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/product_form_stock_layout"
                    style="@style/TillDock.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/products_label_stock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/product_form_input_stock"
                        style="@style/TillDock.Input.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/product_form_threshold_layout"
                    style="@style/TillDock.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:hint="@string/product_label_low_stock_threshold">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/product_form_input_threshold"
                        style="@style/TillDock.Input.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/product_form_button_save"
                style="@style/TillDock.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/common_save" />

            <ProgressBar
                android:id="@+id/product_form_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone" />

            <TextView
                android:id="@+id/product_form_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textColor="@color/error_default"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>