<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/dashboard_avatar"
                android:layout_width="@dimen/dash_avatar_size"
                android:layout_height="@dimen/dash_avatar_size"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="@string/dashboard_section_account">

                <TextView
                    android:id="@+id/dashboard_avatar_initial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_md" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dashboard_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_strong"
                    android:textSize="@dimen/text_md" />

                <TextView
                    android:id="@+id/dashboard_user_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_xs" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/dashboard_action_settings"
                android:layout_width="@dimen/dash_header_icon_button"
                android:layout_height="@dimen/dash_header_icon_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dashboard_section_account"
                android:padding="10dp"
                android:src="@drawable/ic_dash_settings"
                app:tint="@color/text_default" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dashboard_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_strong"
                android:textSize="@dimen/text_xl" />

            <TextView
                android:id="@+id/dashboard_business"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="@string/dashboard_section_quick_actions"
            android:textAllCaps="true"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_xs" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/dashboard_action_business"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_action_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:minHeight="@dimen/dash_tile_min_height"
                android:orientation="vertical"
                android:padding="@dimen/dash_tile_padding">

                <FrameLayout
                    android:layout_width="@dimen/dash_icon_circle_size"
                    android:layout_height="@dimen/dash_icon_circle_size"
                    android:background="@drawable/bg_chip_outline">

                    <ImageView
                        android:layout_width="@dimen/dash_icon_size"
                        android:layout_height="@dimen/dash_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_dash_business"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dashboard_action_business"
                    android:textColor="@color/text_strong"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dashboard_action_categories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_action_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:minHeight="@dimen/dash_tile_min_height"
                android:orientation="vertical"
                android:padding="@dimen/dash_tile_padding">

                <FrameLayout
                    android:layout_width="@dimen/dash_icon_circle_size"
                    android:layout_height="@dimen/dash_icon_circle_size"
                    android:background="@drawable/bg_chip_outline">

                    <ImageView
                        android:layout_width="@dimen/dash_icon_size"
                        android:layout_height="@dimen/dash_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_dash_categories"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dashboard_action_categories"
                    android:textColor="@color/text_strong"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dashboard_action_products"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_action_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:minHeight="@dimen/dash_tile_min_height"
                android:orientation="vertical"
                android:padding="@dimen/dash_tile_padding">

                <FrameLayout
                    android:layout_width="@dimen/dash_icon_circle_size"
                    android:layout_height="@dimen/dash_icon_circle_size"
                    android:background="@drawable/bg_chip_outline">

                    <ImageView
                        android:layout_width="@dimen/dash_icon_size"
                        android:layout_height="@dimen/dash_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_dash_products"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dashboard_action_products"
                    android:textColor="@color/text_strong"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/dashboard_action_inventory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_action_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:minHeight="@dimen/dash_tile_min_height"
                android:orientation="vertical"
                android:padding="@dimen/dash_tile_padding">

                <FrameLayout
                    android:layout_width="@dimen/dash_icon_circle_size"
                    android:layout_height="@dimen/dash_icon_circle_size"
                    android:background="@drawable/bg_chip_outline">

                    <ImageView
                        android:layout_width="@dimen/dash_icon_size"
                        android:layout_height="@dimen/dash_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_dash_inventory"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dashboard_action_inventory"
                    android:textColor="@color/text_strong"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dashboard_action_account"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_action_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:minHeight="@dimen/dash_tile_min_height"
                android:orientation="vertical"
                android:padding="@dimen/dash_tile_padding">

                <FrameLayout
                    android:layout_width="@dimen/dash_icon_circle_size"
                    android:layout_height="@dimen/dash_icon_circle_size"
                    android:background="@drawable/bg_chip_outline">

                    <ImageView
                        android:layout_width="@dimen/dash_icon_size"
                        android:layout_height="@dimen/dash_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_dash_account"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dashboard_section_account"
                    android:textColor="@color/text_strong"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_sm">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_dash_logout"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/dashboard_action_logout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:padding="6dp"
                android:text="@string/dashboard_logout"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>