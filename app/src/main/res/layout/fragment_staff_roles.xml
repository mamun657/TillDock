<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/staff_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_default"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/staff_roles_title"
        app:titleTextColor="@color/text_strong" />

    <TextView
        android:id="@+id/staff_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_base"
        android:paddingTop="@dimen/space_sm"
        android:text="@string/staff_roles_subtitle"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_xs"
        app:layout_constraintTop_toBottomOf="@id/staff_toolbar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/staff_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="@dimen/space_base"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/staff_subtitle"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>