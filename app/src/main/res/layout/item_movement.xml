<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/movement_item_type"
            style="@style/TillDock.Text.Strong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/movement_item_delta"
            style="@style/TillDock.Text.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_md" />
    </LinearLayout>

    <TextView
        android:id="@+id/movement_item_quantities"
        style="@style/TillDock.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textColor="@color/text_default"
        android:textSize="@dimen/text_sm" />

    <TextView
        android:id="@+id/movement_item_reason"
        style="@style/TillDock.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_sm" />

    <TextView
        android:id="@+id/movement_item_time"
        style="@style/TillDock.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_xs" />
</LinearLayout>