<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TillDock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_default</item>
        <item name="colorOnSurface">@color/text_strong</item>
        <item name="colorSurfaceVariant">@color/surface_muted</item>
        <item name="colorOnSurfaceVariant">@color/text_default</item>
        <item name="colorError">@color/error_default</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowBackground">@color/surface_muted</item>
    </style>

    <style name="Theme.TillDock" parent="Base.Theme.TillDock" />

    <style name="TillDockCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface_default</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="TillDockPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="TillDockSecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="TillDockTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TillDockFilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/surface_default</item>
        <item name="android:textColor">@color/text_default</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipCornerRadius">16dp</item>
    </style>
</resources>