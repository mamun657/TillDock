<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TillDock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_default</item>
        <item name="colorOnSurface">@color/text_strong</item>
        <item name="colorSurfaceVariant">@color/surface_muted</item>
        <item name="colorOnSurfaceVariant">@color/text_default</item>
        <item name="colorError">@color/error_default</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowBackground">@color/surface_muted</item>
    </style>

    <style name="Theme.TillDock" parent="Base.Theme.TillDock" />

    <style name="TillDockCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface_default</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="TillDock.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_radius</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_radius</item>
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="hintTextColor">@color/text_default</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <style name="TillDock.Input.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:textColor">@color/text_strong</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TillDock.PrimaryButton" parent="TillDockPrimaryButton" />

    <style name="TillDock.SecondaryButton" parent="TillDockSecondaryButton" />

    <style name="TillDock.TextButton" parent="TillDockTextButton" />

    <style name="TillDock.IconButton.Tinted" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="iconTint">@color/text_strong</item>
        <item name="backgroundTint">@color/surface_default</item>
    </style>

    <style name="TillDock.Text" parent="android:Widget.TextView">
        <item name="android:textColor">@color/text_default</item>
        <item name="android:textSize">@dimen/text_base</item>
    </style>

    <style name="TillDock.Text.H1">
        <item name="android:textColor">@color/text_strong</item>
        <item name="android:textSize">@dimen/text_2xl</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TillDock.Text.H2">
        <item name="android:textColor">@color/text_strong</item>
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TillDock.Text.H3">
        <item name="android:textColor">@color/text_strong</item>
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TillDock.Text.Body">
        <item name="android:textColor">@color/text_default</item>
        <item name="android:textSize">@dimen/text_base</item>
    </style>

    <style name="TillDock.Text.Strong">
        <item name="android:textColor">@color/text_strong</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TillDock.Text.Body.Strong">
        <item name="android:textColor">@color/text_strong</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TillDock.Text.Caption">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_sm</item>
    </style>

    <style name="TillDock.Pill" parent="Widget.Material3.Chip.Assist">
        <item name="chipMinHeight">24dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipStartPadding">@dimen/status_pill_padding_h</item>
        <item name="chipEndPadding">@dimen/status_pill_padding_h</item>
        <item name="android:textSize">@dimen/text_2xs</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TillDock.Pill.Success">
        <item name="android:background">@color/status_in_stock_bg</item>
        <item name="android:textColor">@color/stock_success</item>
    </style>

    <style name="TillDock.Pill.Warning">
        <item name="android:background">@color/status_low_bg</item>
        <item name="android:textColor">@color/stock_warning</item>
    </style>

    <style name="TillDock.Pill.Danger">
        <item name="android:background">@color/status_out_bg</item>
        <item name="android:textColor">@color/stock_danger</item>
    </style>

    <style name="TillDock.Pill.Neutral">
        <item name="android:background">@color/status_archived_bg</item>
        <item name="android:textColor">@color/stock_archived</item>
    </style>

    <style name="TillDockPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="TillDockSecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="TillDockTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TillDockFilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/surface_default</item>
        <item name="android:textColor">@color/text_default</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipCornerRadius">16dp</item>
    </style>

    <style name="TillDock.FilterChip" parent="TillDockFilterChip" />

    <style name="Theme_TillDock_FullDialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@color/surface_subtle</item>
        <item name="colorSurface">@color/surface_subtle</item>
    </style>


</resources>
